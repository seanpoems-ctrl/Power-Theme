//@version=6
// Power Theme Stats — the stats panel from the dashboard's enlarged chart, for TradingView.
//
//   STATS table:    Market Cap · ADR% · ATR · LoD dist. · industry · ATR% Mult. From MA   (optional: % Gain From MA · ATR %)
//   RVOL box:       RVOL · Vol vs Avg · Avg Vol · Avg $ Vol                                 (dark box)
// The two are SEPARATE tables with their own position, text size and offsets, so you can keep the RVOL box at the bottom (next to the volume
// bars) and put the stats wherever you like. Defaults: stats = Middle right, RVOL box = Bottom right.
//
// Definitions (all computed on DAILY bars via request.security, whatever timeframe the chart is on):
//   ADR%            20-day mean of high/low − 1, in %
//   ATR             Wilder ATR(14), in price units
//   LoD dist.       (price − today's low) ÷ ATR, in %  — green when ≤ 40 %
//   ATR% Mult.      ((price ÷ SMA50) − 1) ÷ (ATR ÷ price)  — amber ≥ 4, red ≥ 7
//   RVOL            today's volume ÷ the average of the previous 50 days, shown as a %
//   Vol vs Avg      RVOL − 100 %
//   Avg Vol         mean volume of the previous 50 days
//   Avg $ Vol       Avg Vol × the current price   (same as the original script)
//   RVOL (Pacing)   while the regular US session is open, today's volume is divided by the share of a normal day that has traded so far
//                   (an approximate U-shaped curve, t^0.7) so it reads as a full-day estimate.
// Market cap needs the symbol's share count, so it shows "—" for ETFs and some foreign tickers.
//
// LAYOUT NOTES: Pine can't place a table by pixel. Each table has a Position (9 spots) plus "Vertical offset" (+ up / − down) and "Inset from the
// side", which add blank space (as % of the chart). A table can't leave its pane: Bottom positions are at the floor (a negative offset does nothing
// there) and Top positions are at the ceiling (a positive offset does nothing). Use Middle for free movement both ways. Two tables set to the same
// position will sit on top of each other — give them different positions.
indicator("Power Theme Stats", shorttitle = "PT Stats", overlay = true)

string GRP = "Settings"
int    atrLen   = input.int(14,  "ATR length",                 minval = 1,  group = GRP)
int    adrLen   = input.int(20,  "ADR length",                 minval = 1,  group = GRP)
int    maLen    = input.int(50,  "Moving average length",      minval = 2,  group = GRP)
int    rvolLen  = input.int(50,  "RVOL / volume average length", minval = 5, group = GRP)
bool   pacing   = input.bool(true, "Pace RVOL while the session is open", group = GRP)
float  lodGreen = input.float(40, "LoD dist. green at or below (%)", group = GRP)

string LS = "Stats table"
string statsPos   = input.string("Middle right", "Position", options = ["Bottom right", "Bottom center", "Bottom left", "Middle right", "Middle center", "Middle left", "Top right", "Top center", "Top left"], group = LS)
string statsSize  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = LS)
float  statsVOff  = input.float(0.0, "Vertical offset, % of chart height  (+ up, − down)", minval = -60, maxval = 60, step = 0.5, group = LS)
float  statsInset = input.float(0.0, "Inset from the left/right edge (% of chart width)", minval = 0, maxval = 60, step = 0.5, group = LS)
bool   showInd    = input.bool(true,  "Show industry", group = LS)
bool   showExtra  = input.bool(false, "Show % Gain From MA and ATR %", group = LS)
bool   showStats  = input.bool(true,  "Show the stats table", group = LS)

string LB = "RVOL box"
string boxPos   = input.string("Bottom right", "Position", options = ["Bottom right", "Bottom center", "Bottom left", "Middle right", "Middle center", "Middle left", "Top right", "Top center", "Top left"], group = LB)
string boxSize  = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = LB)
float  boxVOff  = input.float(0.0, "Vertical offset, % of chart height  (+ up, − down)", minval = -60, maxval = 60, step = 0.5, group = LB)
float  boxInset = input.float(0.0, "Inset from the left/right edge (% of chart width)", minval = 0, maxval = 60, step = 0.5, group = LB)
bool   showBox  = input.bool(true,  "Show the RVOL box", group = LB)

string STY = "Style"
color  txtCol   = input.color(#000000, "Stats text colour",        group = STY)
color  boxBg    = input.color(color.new(#27272a, 5), "RVOL box background", group = STY)
color  boxTxt   = input.color(#f4f4f5, "RVOL box text",            group = STY)

sizeS = switch statsSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge
    => size.small

sizeB = switch boxSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge
    => size.small

posS = switch statsPos
    "Bottom center" => position.bottom_center
    "Bottom left"   => position.bottom_left
    "Bottom right"  => position.bottom_right
    "Middle center" => position.middle_center
    "Middle left"   => position.middle_left
    "Top right"     => position.top_right
    "Top center"    => position.top_center
    "Top left"      => position.top_left
    => position.middle_right

posB = switch boxPos
    "Bottom center" => position.bottom_center
    "Bottom left"   => position.bottom_left
    "Middle right"  => position.middle_right
    "Middle center" => position.middle_center
    "Middle left"   => position.middle_left
    "Top right"     => position.top_right
    "Top center"    => position.top_center
    "Top left"      => position.top_left
    => position.bottom_right

fmtBig(float v) =>
    na(v) ? "—" : v >= 1e12 ? str.tostring(v / 1e12, "#.##") + "T" : v >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" : v >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" : v >= 1e3 ? str.tostring(v / 1e3, "#.#") + "K" : str.tostring(v, "#")

// one label / value row (value right-aligned) — one helper per table because each has its own text size
fRowS(table tbl, int c0, int r, string k, string v, color kc, color vc) =>
    table.cell(tbl, c0,     r, k, text_color = kc, text_halign = text.align_left,  text_size = sizeS)
    table.cell(tbl, c0 + 1, r, v, text_color = vc, text_halign = text.align_right, text_size = sizeS)

fRowB(table tbl, int c0, int r, string k, string v, color kc, color vc, color bg) =>
    table.cell(tbl, c0,     r, k, text_color = kc, bgcolor = bg, text_halign = text.align_left,  text_size = sizeB)
    table.cell(tbl, c0 + 1, r, v, text_color = vc, bgcolor = bg, text_halign = text.align_right, text_size = sizeB)

// ── calculations (all on the DAILY timeframe) ────────────────────────────────────────────────────────────────────
[atr, adr, ma, avgVol, lowD, volD] = request.security(syminfo.tickerid, "D",
     [ta.atr(atrLen), (ta.sma(high / low, adrLen) - 1) * 100, ta.sma(close, maLen), ta.sma(volume[1], rvolLen), low, volume],
     lookahead = barmerge.lookahead_off)
float px      = close                                                 // current price (the chart's last close, live)
float ext     = atr > 0 and ma > 0 ? ((px / ma) - 1) / (atr / px) : na
float gainMa  = ma > 0 ? (px / ma - 1) * 100 : na
float atrPct  = px > 0 ? atr / px * 100 : na
float lod     = atr > 0 ? (px - lowD) / atr * 100 : na
float mcap    = nz(syminfo.shares_outstanding_total) > 0 ? syminfo.shares_outstanding_total * px : na
float avgDvol = avgVol * px

// Share of a normal US session's volume that has traded so far (ET). 1 when the market is closed.
float paceFrac = 1.0
if pacing and barstate.islast and session.ismarket
    int mins = hour(timenow, "America/New_York") * 60 + minute(timenow, "America/New_York")
    if mins >= 570 and mins < 960 and dayofweek(timenow, "America/New_York") != dayofweek.saturday and dayofweek(timenow, "America/New_York") != dayofweek.sunday
        paceFrac := math.max(0.05, math.pow((mins - 570) / 390.0, 0.7))
bool  paced = paceFrac < 1.0
float rvol  = avgVol > 0 ? (volD / paceFrac) / avgVol : na
float vsAvg = na(rvol) ? na : (rvol - 1) * 100

// ── tables (rebuilt on the last bar so the row counts follow the options) ─────────────────────────────────────────
var table tS = na
var table tB = na

if barstate.islast
    if not na(tS)
        table.delete(tS)
    if not na(tB)
        table.delete(tB)

    // ── STATS table ─────────────────────────────────────────────────────────────────────────────────────────────
    if showStats
        bool sTop    = str.startswith(statsPos, "Top")
        bool sBottom = str.startswith(statsPos, "Bottom")
        bool sLeft   = str.endswith(statsPos, "left")
        bool sRight  = str.endswith(statsPos, "right")
        bool sBelow  = statsVOff > 0 and not sTop         // blank row under the table pushes it UP
        bool sAbove  = statsVOff < 0 and not sBottom      // blank row over the table pushes it DOWN
        bool sInset  = statsInset > 0 and (sLeft or sRight)
        int  sC0     = sInset and sLeft ? 1 : 0
        int  sCols   = 2 + (sInset ? 1 : 0)
        int  sR0     = sAbove ? 1 : 0
        int  sRows   = 4 + (showInd ? 1 : 0) + 1 + (showExtra ? 2 : 0) + (sAbove ? 1 : 0) + (sBelow ? 1 : 0)
        tS := table.new(posS, sCols, sRows, frame_width = 0, border_width = 0)

        color extCol = na(ext) ? txtCol : ext >= 7 ? #991b1b : ext >= 4 ? #92400e : txtCol
        color lodCol = not na(lod) and lod <= lodGreen ? #166534 : txtCol

        int r = sR0
        fRowS(tS, sC0, r, "Market Cap", na(mcap) ? "—" : fmtBig(mcap), txtCol, txtCol)
        r += 1
        fRowS(tS, sC0, r, "ADR%", str.tostring(adr, "#.##") + "%", txtCol, txtCol)
        r += 1
        fRowS(tS, sC0, r, "ATR", str.tostring(atr, format.mintick), txtCol, txtCol)
        r += 1
        fRowS(tS, sC0, r, "LoD dist.", na(lod) ? "—" : str.tostring(lod, "#") + "%", txtCol, lodCol)
        r += 1
        if showInd
            table.cell(tS, sC0, r, syminfo.industry, text_color = txtCol, text_halign = text.align_right, text_size = sizeS)
            table.merge_cells(tS, sC0, r, sC0 + 1, r)
            r += 1
        fRowS(tS, sC0, r, "ATR% Mult. From MA", na(ext) ? "—" : str.tostring(ext, "#.##"), txtCol, extCol)
        r += 1
        if showExtra
            fRowS(tS, sC0, r, "% Gain From MA", na(gainMa) ? "—" : str.tostring(gainMa, "#.##") + "%", txtCol, txtCol)
            r += 1
            fRowS(tS, sC0, r, "ATR %", na(atrPct) ? "—" : str.tostring(atrPct, "#.##") + "%", txtCol, txtCol)
            r += 1

        if sInset
            table.cell(tS, sLeft ? 0 : 2, sR0, "", width = statsInset)
        if sAbove
            table.cell(tS, 0, 0, "", height = -statsVOff)
        if sBelow
            table.cell(tS, 0, sRows - 1, "", height = statsVOff)

    // ── RVOL box ────────────────────────────────────────────────────────────────────────────────────────────────
    if showBox
        bool bTop    = str.startswith(boxPos, "Top")
        bool bBottom = str.startswith(boxPos, "Bottom")
        bool bLeft   = str.endswith(boxPos, "left")
        bool bRight  = str.endswith(boxPos, "right")
        bool bBelow  = boxVOff > 0 and not bTop
        bool bAbove  = boxVOff < 0 and not bBottom
        bool bInset  = boxInset > 0 and (bLeft or bRight)
        int  bC0     = bInset and bLeft ? 1 : 0
        int  bCols   = 2 + (bInset ? 1 : 0)
        int  bR0     = bAbove ? 1 : 0
        int  bRows   = 4 + (bAbove ? 1 : 0) + (bBelow ? 1 : 0)
        tB := table.new(posB, bCols, bRows, frame_width = 0, border_width = 0)

        color vsCol = na(vsAvg) ? boxTxt : vsAvg >= 0 ? #4ade80 : #f87171

        int rb = bR0
        fRowB(tB, bC0, rb, paced ? "RVOL (Pacing)" : "RVOL", na(rvol) ? "—" : str.tostring(rvol * 100, "#.##") + "%", boxTxt, boxTxt, boxBg)
        rb += 1
        fRowB(tB, bC0, rb, paced ? "Vol vs Avg (Est)" : "Vol vs Avg", na(vsAvg) ? "—" : (vsAvg > 0 ? "+" : "") + str.tostring(vsAvg, "#.##") + "%", boxTxt, vsCol, boxBg)
        rb += 1
        fRowB(tB, bC0, rb, "Avg Vol", fmtBig(avgVol), boxTxt, boxTxt, boxBg)
        rb += 1
        fRowB(tB, bC0, rb, "Avg $ Vol", "$" + fmtBig(avgDvol), boxTxt, boxTxt, boxBg)

        if bInset
            table.cell(tB, bLeft ? 0 : 2, bR0, "", width = boxInset)
        if bAbove
            table.cell(tB, 0, 0, "", height = -boxVOff)
        if bBelow
            table.cell(tB, 0, bRows - 1, "", height = boxVOff)
